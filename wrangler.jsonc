{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lcg-opportunity-management",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".output/public", "binding": "ASSETS" },
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lcg-opp-db",
      // Replace with the id printed by `npx wrangler d1 create lcg-opp-db`.
      // Local dev works with this placeholder.
      "database_id": "00000000-0000-0000-0000-000000000000",
      // SQL migrations are generated by drizzle-kit and applied by wrangler.
      "migrations_dir": "server/database/migrations"
      // Uncomment to make `nuxt dev` talk to the real D1 in Cloudflare (careful: real data):
      // , "remote": true
    }
  ]
}
