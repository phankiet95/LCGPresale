{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "opp",
	"main": ".output/server/index.mjs",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".output/public",
		"binding": "ASSETS"
	},
	// SRS 5.12 weekly snapshot: Monday 00:05 JST = Sunday 15:05 UTC (server/plugins/weekly-snapshot.ts)
	"triggers": {
		"crons": ["5 15 * * SUN"]
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lcg-opp-db",
			// Real D1 id. `nuxt dev` / --local still use a local copy in .wrangler/state.
			"database_id": "69a60031-cbf7-4ad4-af1b-a8e7f252216c",
			// SQL migrations are generated by drizzle-kit and applied by wrangler.
			"migrations_dir": "server/database/migrations",
			// `nuxt dev` talks to the REAL D1 in Cloudflare (real data!). Comment out to use the local copy again.
			"remote": true
		}
	]
}