      "checkConstraints": {
        "chk_opp_stage": {
          "name": "chk_opp_stage",
          "value": "stage IN ('O', 'D', 'C', 'B', 'A', 'W', 'L')"
        },
        "chk_opp_status": {
          "name": "chk_opp_status",
          "value": "status IN ('Active', 'On Hold', 'Closed')"
        },
        "chk_opp_amount": {
          "name": "chk_opp_amount",
          "value": "amount >= 0"
        },
        "chk_opp_win_rate": {
          "name": "chk_opp_win_rate",
          "value": "win_rate_override IS NULL OR (win_rate_override BETWEEN 0 AND 100)"
        },
        "chk_closed_consistency": {
          "name": "chk_closed_consistency",
          "value": "(stage IN ('W','L')) = (status = 'Closed')"
        },
        "chk_closed_at": {
          "name": "chk_closed_at",
          "value": "stage NOT IN ('W','L') OR closed_at IS NOT NULL"
        },
        "chk_lost_reason": {
          "name": "chk_lost_reason",
          "value": "stage <> 'L' OR lost_reason IS NOT NULL"
        },
        "chk_won_amount": {
          "name": "chk_won_amount",
          "value": "stage <> 'W' OR amount > 0"
        },
        "chk_pending": {
          "name": "chk_pending",
          "value": "status <> 'On Hold' OR pending_reason IS NOT NULL"
        }
      }
